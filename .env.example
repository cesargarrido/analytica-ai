# ===== Copia a .env (o configura en Coolify) =====

# --- PostgreSQL (si no se define, la web usa almacenamiento en memoria) ---
DATABASE_URL=postgres://analytica:analytica@localhost:5432/analytica

# --- URL del motor Python (FastAPI) ---
ENGINE_URL=http://localhost:8000

# --- IA opcional: resumen narrativo del análisis ---
# Compatible con OpenAI y con cualquier API estilo OpenAI (DeepSeek, etc.)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# --- Web ---
WEB_PORT=3000
